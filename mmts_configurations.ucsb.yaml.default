### MMTS configuration -- UCSB
###
### Mirrored from the live config on klong.physics.ucsb.edu (128.111.19.78)
### at /home/hep/MultiModuleTeststandUI/data/mmts_configurations.yaml, read 2026-09-10.
###
### Intended for a DEV instance (e.g. a laptop), not for klong itself.
### Deliberate differences from the klong file are marked [DEV] below; everything
### else is verbatim. See the bottom of this file for the notes.


### the same as Andrew's module testing GUI
DBDatabase: hgcdb
DBHostname: 'gut.physics.ucsb.edu'
DBPassword: 'hgcdb password'
DBUsername: teststand_user
### [DEV] klong uses /home/hep/MMTSdata/ . Point this at a local directory:
###       the app writes daqplots/ here, and a run would write results here.
DataLoc: /Users/blackmac/Docs/1Research/MMTS/MultiModuleTeststandUI/DAQresults/
DebugMode: true
DefaultFontSize: '15'
DefaultMaxVoltage: 500
FPGAHostname:
### [DEV] klong has 'kria4.physcis.ucsb.edu' -- that is a typo and does not resolve.
- kria4.physics.ucsb.edu
FPGAType:
- Kria
HVDiscoveryMode: by-resource
#HVResource: ASRL/dev/ttyUSB1::INSTR  ### commented out on klong too
HVTerminal: Rear
HVWiresPolarization: Reverse
HasHVSwitch: true
HasLocalDB: true
HasRHSensor: false
HexactrlSWBranch: ROCv3
Inspectors:
- cgrieco
MACSerial: SB
PCKeyLoc: /home/hgcal/.ssh/id_rsa
Station: Multi-Module Test Stand
TestingPCOpSys: Alma9


### MMTS specified options
### 24 tray positions, 8 rows x (L,C,R), loaded top to bottom.
### IP is empty on klong, so no Kria is addressable from this config. Leaving it
### empty on a dev box is also what keeps a stray "Run" from reaching real hardware.
MMTS_channel_config:
  1L: {HVchannel:  1, IP: '', pullerPORT: 6002, type: Kria}
  1C: {HVchannel:  2, IP: '', pullerPORT: 6003, type: Kria}
  1R: {HVchannel:  3, IP: '', pullerPORT: 6004, type: Kria}
  2L: {HVchannel:  4, IP: '', pullerPORT: 6005, type: Kria}
  2C: {HVchannel:  5, IP: '', pullerPORT: 6006, type: Kria}
  2R: {HVchannel:  6, IP: '', pullerPORT: 6007, type: Kria}
  3L: {HVchannel:  7, IP: '', pullerPORT: 6008, type: Kria}
  3C: {HVchannel:  8, IP: '', pullerPORT: 6009, type: Kria}
  3R: {HVchannel:  9, IP: '', pullerPORT: 6010, type: Kria}
  4L: {HVchannel: 10, IP: '', pullerPORT: 6011, type: Kria}
  4C: {HVchannel: 11, IP: '', pullerPORT: 6012, type: Kria}
  4R: {HVchannel: 12, IP: '', pullerPORT: 6013, type: Kria}
  5L: {HVchannel: 13, IP: '', pullerPORT: 6014, type: Kria}
  5C: {HVchannel: 14, IP: '', pullerPORT: 6015, type: Kria}
  5R: {HVchannel: 15, IP: '', pullerPORT: 6016, type: Kria}
  6L: {HVchannel: 16, IP: '', pullerPORT: 6017, type: Kria}
  6C: {HVchannel: 17, IP: '', pullerPORT: 6018, type: Kria}
  6R: {HVchannel: 18, IP: '', pullerPORT: 6019, type: Kria}
  7L: {HVchannel: 19, IP: '', pullerPORT: 6020, type: Kria}
  7C: {HVchannel: 20, IP: '', pullerPORT: 6021, type: Kria}
  7R: {HVchannel: 21, IP: '', pullerPORT: 6022, type: Kria}
  8L: {HVchannel: 22, IP: '', pullerPORT: 6023, type: Kria}
  8C: {HVchannel: 23, IP: '', pullerPORT: 6024, type: Kria}
  8R: {HVchannel: 24, IP: '', pullerPORT: 6025, type: Kria}
  ### The three multiplexer-board slots (task4, task5). HVchannel is only read
  ### when MMTS_bench.hv.switch is vitrek; with the cable moved by hand these
  ### numbers are unused.
  A: {HVchannel: 25, IP: '', pullerPORT: 6001, type: Kria}
  B: {HVchannel: 26, IP: '', pullerPORT: 6001, type: Kria}
  C: {HVchannel: 27, IP: '', pullerPORT: 6001, type: Kria}

### Multi Pedestal Run (task4): the bench behind hexactrl-script/multimodule.
### client_host owns daq-client, unpack, ROOT and the $MM scripts. It is the box
### that reaches the Kria; leave it empty once the GUI runs on that same box.
### [DEV] klong is the client host (moved from pi0 2026-09-23). Its bench lives in
###       /data/hep/mmts, and mmts_shell loads /data/hep/mmts/env.sh instead of
###       ~/.bashrc, so the production GUI's environment is untouched.
###       On klong itself set client_host: '' and keep client_shell.
MMTS_bench:
  client_host: 'hep@klong.physics.ucsb.edu'
  client_shell: '/data/hep/mmts/bin/mmts_shell'
  ### Kria dropdown on the task4/task5 pages; the first is preselected.
  krias:
    - kria11.physics.ucsb.edu
  slots: [A, B, C]
  default_nruns: 5
  default_label: ped
  skip_probe: 1              ### 1 = use the shipped link map; a 12+12 probe costs a bring-up
  bringup_tries: 12

  ### HV pedestal scan (task5). The instrument itself is under MMTS_hardwares.
  hv:
    ### none = one HV cable, moved by hand, the job pauses and asks.
    ### vitrek = three cables into a Vitrek 964i, relay per slot.
    switch: none
    settle_s: 5                            ### after reaching a voltage, before reading
    leak_check_volts: [0, 1, 10, 100, 300] ### the single-module stand's own list
    ### 1000 uA = 1 mA. Decided 2026-09-16 after every slot aborted at the 0 V
    ### point: this bench reads 2.86 uA lit / 1.51 uA dark at ZERO bias (open
    ### bench, no dark box, plus an unexplained dark residual), so a 1 uA gate
    ### can never be passed here. At 1 mA the check is a SHORT detector just
    ### below the 1.05 mA compliance, not a sensor-quality check: it no longer
    ### catches a mildly leaky sensor. Lower it per run in the form when the
    ### modules are in the dark and the zero-bias offset is understood.
    leak_abort_uA: 1000                    ### above this below 500 V, skip the slot
    pause_timeout_s: 3600                  ### how long "move the cable" waits for Continue
    ### hv.py runs on the CLIENT host and imports the single-module stand's own
    ### driver and configuration.yaml; these two say where to find that GUI.
    gui_dir: /home/hep/hgcal-module-testing-gui
    python: python3

MMTS_package_path:
  HGCal_Module_Production_Toolkit: external_packages/HGCal_Module_Production_Toolkit
  hgcal_module_testing_gui: external_packages/hgcal-module-testing-gui

MMTS_hardwares:
  keithley:
    DiscoveryMode: by-resource
    Resource: 'ASRL/dev/ttyUSB0::INSTR'
    Terminal: Front
    WiresPolarization: Reverse   ### the same as the single-module stand: +BV
    ### 🔑 1.05 mA, the driver's own default and what the single-module stand
    ### runs. NOT lower: the 2410 refuses a measure range above the compliance
    ### range, and KeithleyPowerSupply hardcodes the 100 uA range and switches
    ### up to 1 mA above 50 uA. A 10 uA compliance gave error 824 "Cannot exceed
    ### compliance range" and a bogus 1.48 uA reading AT 0 V (2026-09-16).
    ### Protection against a short comes from the leakage abort, not from here.
    CurrentLimit: 5.25e-3   ### compliance in A; must stay ABOVE leak_abort_uA
    MaxVoltage: 800         ### instrument ceiling; board_params caps LD at 600
  vitek:
    DiscoveryMode: by-resource
    Resource: 'ASRL/dev/ttyUSB1::INSTR'
    BaudRate: 9600
    ReadTermination: "\n"
    WriteTermination: "\n"

### [DEV] klong reaches Grafana as 127.0.0.1:3000, which only renders in a browser
###       running on klong. Use the hostname so the panels load from anywhere on
###       the UCSB network. Both dashboard UIDs are UCSB's own.
externalURL:
  EnvMonitor:
    URL: "http://klong.physics.ucsb.edu:3000/d/adqczw2/thermal-box-environment-for-mmts?orgId=1&from=now-15m&to=now&timezone=browser&refresh=1m"
    height: 350px
  IVCurveOnline:
    URL: 'http://klong.physics.ucsb.edu:3000/d/iv_curve-plot-forMMTS/iv-curve-plot-for-mmts?orgId=1&theme=light&from=now-24h&to=now&timezone=browser&var-N_MODULE_SHOW=24&var-bp_material=$__all&var-resolution=$__all&var-roc_version=$__all&var-geometry=$__all&var-sen_thickness=$__all&var-iv_grade=$__all&kiosk'
    height: 650px

inspector: UCSB MMTS

path_HGCal_Module_Production_Toolkit: external_packages/HGCal_Module_Production_Toolkit
path_hgcal_module_testing_gui: external_packages/hgcal-module-testing-gui

thermalcycle_stagenames:
  ### key would be put into database. (with postfix date). The recorded value would be "stage1-20260308' YYYYMMDD
  ### and value would be shown on MMTS GUI option. Feel free to modify the descriptions.
  stage1: 'stage1: room condition, high humidity'
  stage2: 'stage2: first low temperature'
  stage3: 'stage3: last low temperature'
  stage4: 'stage4: final IV, normal temperature'
  test: 'testing here'

thermalcycle_iterations:
  ### key would be put into hgcapi - mmts_iv_test - iteration
  ### value as a description would be shown on MMTS GUI option.
  iteration_1: 'iteration_1: room condition, high humidity'
  iteration_2: 'iteration_2: first low temperature'
  iteration_3: 'iteration_3: last low temperature'
  iteration_4: 'iteration_4: final IV, normal temperature'
  test: 'testing here'


### ---------------------------------------------------------------------------
### Notes on the klong original
###
### 1. klong's file defines `externalURL:` TWICE. The first block (both URLs set
###    to http://127.0.0.1:5001, height 200px) is silently discarded, because
###    PyYAML keeps the last duplicate key. Only one block here.
###
### 2. Inspectors differs between the two config files on klong:
###      data/mmts_configurations.yaml                          -> [cgrieco]
###      external_packages/.../configuration.yaml               -> [cgreico, dzhang]
###    Note the transposed letters. The GUI dropdown reads the Andrew file, so it
###    is the cgreico spelling that reaches the database. Worth reconciling.
###
### 3. PCKeyLoc is /home/hgcal/.ssh/id_rsa here but /home/hep/.ssh/id_rsa in the
###    Andrew config on klong. /home/hgcal does not exist on klong (only /home/hep).
###
### 4. UCSB runs a second Grafana on port 3001 (the PLC/MQTT stack in
###    /home/hep/PLC_toolkits_mqtt_NTU). It requires auth and holds no MMTS
###    dashboard, so nothing here points at it.
